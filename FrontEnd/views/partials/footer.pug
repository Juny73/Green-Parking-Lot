footer.pie
  .pie-interior
    .pie-marca
      a.logo(href='/')
        span.logo-marca P
        span.logo-texto Green Parking Lot
      p Parqueadero para motos y autos. Reserva tu celda, entra sin filas y paga sin contacto.
    nav.pie-enlaces(aria-label='Enlaces del pie')
      a(href='/') Inicio
      a(href='/quienes-somos') Quiénes somos
      a(href='/servicios') Servicios
      a(href='/contacto') Contacto
    .pie-redes
      p Síguenos
      .redes
        a(href='https://facebook.com', target='_blank', rel='noopener', aria-label='Facebook'): i.bi.bi-facebook
        a(href='https://instagram.com', target='_blank', rel='noopener', aria-label='Instagram'): i.bi.bi-instagram
        a(href='https://wa.me/573000000000', target='_blank', rel='noopener', aria-label='WhatsApp'): i.bi.bi-whatsapp
        a(href='https://x.com', target='_blank', rel='noopener', aria-label='X'): i.bi.bi-twitter-x
  .pie-base © #{new Date().getFullYear()} Green Parking Lot. Todos los derechos reservados.
