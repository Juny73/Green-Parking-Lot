extends layout

block contenido
  section.seccion
    h1 Servicios
    .rejilla
      article.tarjeta
        i.bi.bi-clock
        h3 Parqueo por horas
        p Pagas solo el tiempo que usas, con cobro por hora o fracción.
      article.tarjeta
        i.bi.bi-calendar-event
        h3 Reservas
        p Agenda tu celda desde tu cuenta y llega con el espacio asegurado.
      article.tarjeta
        i.bi.bi-award
        h3 Membresías
        p Planes mensual y anual con descuentos y días gratis.
      article.tarjeta
        i.bi.bi-credit-card
        h3 Pago sin contacto
        p Efectivo, tarjeta o transferencia, con factura de cada salida.
      article.tarjeta
        i.bi.bi-droplet
        h3 Lavado
        p Descuento en lavado de vehículos para miembros.
      article.tarjeta
        i.bi.bi-camera-video
        h3 Vigilancia
        p Registro de incidencias y seguimiento de cada evento.
    h2 Tarifas de referencia
    table.tabla
      thead
        tr
          th Vehículo
          th Tarifa por hora
      tbody
        tr
          td Moto
          td $2.000
        tr
          td Auto o camioneta
          td $4.000
    p.nota Las tarifas las define el administrador y pueden cambiar.
